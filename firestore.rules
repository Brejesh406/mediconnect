rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 0. Connection Test Collection
    match /test/{docId} {
      allow read: if true;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'brejesh0607@gmail.com' ||
        request.auth.token.email == 'admin@mediconnect.health' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) &&
        incoming().keys().hasAll(['id', 'email', 'role', 'fullName']) &&
        incoming().id == userId &&
        incoming().email is string && incoming().email.size() <= 128 &&
        incoming().fullName is string && incoming().fullName.size() <= 100 &&
        incoming().role in ['patient', 'doctor', 'admin'];
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // 2. Patients Collection (Medical PII Isolation)
    match /patients/{patientId} {
      allow get: if isSignedIn() && (isOwner(patientId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(patientId) || isAdmin()) &&
        incoming().id == patientId;
      allow update: if isSignedIn() && (isOwner(patientId) || isAdmin()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // 3. Doctors Collection
    match /doctors/{doctorId} {
      allow read: if true; // Public roster of accredited hospital specialists
      allow create, update: if isSignedIn() && (isOwner(doctorId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 4. Departments Collection
    match /departments/{departmentId} {
      allow read: if true; // Public list of clinical departments
      allow write: if isAdmin();
    }

    // 5. Appointments Collection
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (
        existing().patientId == request.auth.uid ||
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().patientId == request.auth.uid ||
        isAdmin()
      ) &&
      incoming().status in ['pending', 'confirmed'] &&
      incoming().appointmentDate is string &&
      incoming().startTime is string;
      allow update: if isSignedIn() && (
        existing().patientId == request.auth.uid ||
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 6. Medical Records (Encounters)
    match /medical_records/{recordId} {
      allow get: if isSignedIn() && (
        existing().patientId == request.auth.uid ||
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 7. Prescriptions
    match /prescriptions/{prescriptionId} {
      allow get: if isSignedIn() && (
        existing().patientId == request.auth.uid ||
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
