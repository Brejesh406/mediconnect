{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and role identity in the hospital system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role", "fullName"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient medical details, blood group, allergies, and insurance policy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "maxLength": 20 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "emergencyContact": { "type": "string", "maxLength": 100 },
        "emergencyPhone": { "type": "string", "maxLength": 30 },
        "allergies": { "type": "string", "maxLength": 500 },
        "insuranceProvider": { "type": "string", "maxLength": 100 },
        "insurancePolicyNumber": { "type": "string", "maxLength": 50 }
      },
      "required": ["id"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Physician credentials, specialty, department assignment, and room number",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 100 },
        "specialization": { "type": "string", "maxLength": 100 },
        "qualifications": { "type": "string", "maxLength": 200 },
        "consultationFee": { "type": "number" },
        "roomNumber": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "departmentId", "title", "specialization"]
    },
    "Department": {
      "title": "Department",
      "description": "Medical specialty departments within the medical center",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 50 },
        "locationFloor": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "code"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Consultation appointment between a patient and attending specialist",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "appointmentDate": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "rejected"] },
        "reasonForVisit": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "patientId", "doctorId", "appointmentDate", "startTime", "status", "reasonForVisit"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Clinical encounter notes, vitals, diagnosis, and treatment plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "recordDate": { "type": "string", "maxLength": 20 },
        "diagnosis": { "type": "string", "maxLength": 200 },
        "symptoms": { "type": "string", "maxLength": 500 },
        "clinicalNotes": { "type": "string", "maxLength": 2000 },
        "treatmentPlan": { "type": "string", "maxLength": 1000 },
        "vitalsBloodPressure": { "type": "string", "maxLength": 30 },
        "vitalsHeartRate": { "type": "number" },
        "vitalsTemperature": { "type": "number" },
        "vitalsSpo2": { "type": "number" }
      },
      "required": ["id", "patientId", "doctorId", "recordDate", "diagnosis"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Medication orders issued by a clinician",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "issuedDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "completed", "discontinued"] },
        "instructions": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "patientId", "doctorId", "issuedDate", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app alerts for appointments, prescriptions, and health updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["appointment", "prescription", "system", "record"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profiles and credentials index"
    },
    "/patients/{patientId}": {
      "schema": "#/entities/Patient",
      "description": "Private patient clinical baseline data"
    },
    "/doctors/{doctorId}": {
      "schema": "#/entities/Doctor",
      "description": "Doctor specialty and clinic info"
    },
    "/departments/{departmentId}": {
      "schema": "#/entities/Department",
      "description": "Hospital medical departments"
    },
    "/appointments/{appointmentId}": {
      "schema": "#/entities/Appointment",
      "description": "Scheduled hospital encounters"
    },
    "/medical_records/{recordId}": {
      "schema": "#/entities/MedicalRecord",
      "description": "Confidential patient consultation charts"
    },
    "/prescriptions/{prescriptionId}": {
      "schema": "#/entities/Prescription",
      "description": "Electronically authorized prescriptions"
    },
    "/notifications/{notificationId}": {
      "schema": "#/entities/Notification",
      "description": "User notification inbox"
    }
  }
}
